# Streamlit Secrets Template
# Copy this file to secrets.toml and fill in your actual values
# NEVER commit the actual secrets.toml file to GitHub

[database]
# PostgreSQL connection (if using database)
host = "your-database-host"
port = 5432
database = "meridian_mmm"
user = "your-username"
password = "your-password"

[api]
# API keys if needed
google_analytics_key = "your-ga-key"
